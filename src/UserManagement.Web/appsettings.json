{
    "MongoDB": {
        "ConnectionString": "",
        "DatabaseName": ""
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        }
    },
    "Jwt": {
        "Issuer": "UserManagementApi",
        "Audience": "UserManagementClient",
        "ExpiryMinutes": 60,
        "Key": ""
    },
    "RefreshToken": {
        "ExpiryDays": 7,
        "CookieName": "refresh_token"
    },
    "AccountSecurity": {
        "FrontendBaseUrl": "http://localhost:3000",
        "PasswordResetTokenExpiryMinutes": 30,
        "EmailVerificationTokenExpiryMinutes": 1440,
        "AccountEmailCooldownSeconds": 60,
        "MaxFailedSigninAttempts": 5,
        "LockoutMinutes": 15
    },
    "Audit": {
        "RetentionDays": 90
    },
    "Captcha": {
        "SecretKey": "",
        "AllowedHostnames": [],
        "SigninRequiredAfterFailedAttempts": 2
    },
    "Email": {
        "Provider": "Resend"
    },
    "Resend": {
        "ApiKey": "",
        "FromEmail": "onboarding@resend.dev",
        "FromName": "User Management"
    },
    "DataProtection": {
        "CertificateBase64": "",
        "CertificatePassword": ""
    },
    "Cors": {
        "AllowedOrigins": [
            ""
        ]
    },
    "FileStorage": {
        "Provider": "CloudflareR2" // Local / CloudflareR2
    },
    "CloudflareR2": {
        "AccessKeyId": "your-access-key-id",
        "SecretAccessKey": "your-secret-access-key",
        "BucketName": "user-profile-images",
        "PublicBaseUrl": "https://your-public-r2-domain",
        "S3Endpoint":""
    },
    "ForwardedHeaders": {
        "KnownProxies": []
    },
    "RateLimiting": {
        "TrustCloudflareConnectingIp": false
    },
    "AllowedHosts": "*"
}
